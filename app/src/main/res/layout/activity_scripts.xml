<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本管理器（P3，2026-09-18）：本地导入 JSON + 启用开关。
  入口：首次启动 app 自动出现；之后由悬浮窗「设置」长按进入（P4）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/scripts_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="脚本管理"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scripts_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="导入本地 JSON 脚本（写入应用私有目录，不联网）；开关控制是否在悬浮窗显示。长按某行可恢复内置。" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/scripts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 滑动测试（2026-09-18 由悬浮窗迁入，用户需求③）：真机调翻页滑动参数。
         管理器在前台会吃掉注入的手势 ⇒ 点「开始测试」先退到后台把前台让回游戏，再注入（见 MainActivity）。 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="滑动测试（调翻页参数）"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/swipe_method_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/swipe_method_three"
            android:contentDescription="三段式滑动"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="三段式"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/swipe_method_chain"
            android:contentDescription="路标链滑动"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="路标链"
            android:textSize="13sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/swipe_start_y"
            android:contentDescription="滑动起点 Y"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="起点Y"
            android:inputType="number"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/swipe_dist"
            android:contentDescription="滑动距离"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="距离"
            android:inputType="number"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_swipe_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="开始测试" />
    </LinearLayout>

    <!-- 通用提醒横幅（NoticeCenter 的管理器展位）：管理器在前台时提醒显示在这里 -->
    <TextView
        android:id="@+id/notice_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_import"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导入 JSON" />

        <Button
            android:id="@+id/btn_back_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="返回悬浮窗" />
    </LinearLayout>
</LinearLayout>
