<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本管理器（2026-09-18 重写）。
  设计原则：**动作贴近它作用的对象** —— 脚本列表的动作（导入脚本）在脚本区；GOOD 数据的动作
  （导出/选择）在 GOOD 数据区；只有作用于整个应用的动作（回到悬浮窗）才放页面底部。
  颜色全部走 `pocket_*` token（浅色在 values、深色在 values-night，跟随系统深浅色）。
  入口：首次启动自动出现；之后**长按悬浮窗的日志按钮**进入。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/scripts_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="脚本管理"
        android:textColor="@color/pocket_text"
        android:textSize="24sp" />

    <!-- ★ #310/M4 后台模式区块（runMode==BACKGROUND 才显示，默认 GONE）：
         从上到下是用户动线本身 —— 选模式 → 引导卡（Shizuku 四态之一，恰好一个下一步）
         → 虚拟屏监视区（就绪后接管）→ 一句边界提示。结构（行/圆点/文案）照抄
         status_card 与 swipe_row 的既有写法，不引入新样式。 -->
        <!-- 运行模式行：标签 + 横排 RadioGroup（结构与 swipe_card 的方法选择同款） -->
        <LinearLayout
            android:id="@+id/runmode_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pocket_card_outline"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行模式"
                android:textColor="@color/pocket_text"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/runmode_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_mode_foreground"
                    android:contentDescription="前台模式（原形态）"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="前台"
                    android:textColor="@color/pocket_text"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_mode_background"
                    android:contentDescription="后台模式（虚拟显示器 + Shizuku 提权）"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="后台"
                    android:textColor="@color/pocket_text"
                    android:textSize="13sp" />
            </RadioGroup>
        </LinearLayout>

    <LinearLayout
        android:id="@+id/bg_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Shizuku 引导卡：四态机渲染目标（phase != READY 时显示） -->
        <LinearLayout
            android:id="@+id/shizuku_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pocket_card_outline"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/shizuku_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_overlay_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shizuku_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/shizuku_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="重启手机后需重新打开 Shizuku 启动服务，属正常现象"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/shizuku_action_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 虚拟屏监视区：Shizuku READY 后接管（M4：预览与帧率是占位，M5 接帧流） -->
        <LinearLayout
            android:id="@+id/vd_monitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pocket_card_outline"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/vd_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vd_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_overlay_status_dot" />

                <TextView
                    android:id="@+id/vd_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="待机"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/vd_fps_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="-- fps"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/vd_preview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@color/black"
                android:scaleType="fitCenter"
                android:contentDescription="虚拟屏画面预览" />

            <TextView
                android:id="@+id/vd_preview_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="预览（M5 接帧流）"
                android:textColor="@color/pocket_text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/vd_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_vd_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动虚拟屏"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_vd_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="关闭虚拟屏"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_vd_front"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="游戏调回前台"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/bg_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="后台模式期间请保持本页可见以查看预览；预览不采集时扫描照常进行"
            android:textColor="@color/pocket_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/status_card"
        android:contentDescription="无障碍与悬浮窗状态，点击去开启无障碍"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pocket_card_outline"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_overlay_status_dot" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/pocket_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去开启"
            android:textColor="@color/pocket_accent"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="脚本"
                    android:textColor="@color/pocket_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/scripts_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scripts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/calibrate_row"
                android:contentDescription="展开或收起标定流程"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="标定流程"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/calibrate_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开发用"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/calibrate_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▾"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calibrate_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_import"
                android:contentDescription="导入脚本 JSON 文件"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pocket_dashed"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="+ 导入脚本 JSON"
                android:textColor="@color/pocket_accent"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/good_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GOOD 数据"
                    android:textColor="@color/pocket_text"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pocket_card_outline"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="扫描结果"
                            android:textColor="@color/pocket_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/good_export_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="还没有导出"
                            android:textColor="@color/pocket_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_good_export"
                        android:contentDescription="导出最近一次扫描结果"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_action_export" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pocket_card_outline"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="执行输入"
                            android:textColor="@color/pocket_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/good_input_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="未选择"
                            android:textColor="@color/pocket_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_good_pick"
                        android:contentDescription="选择输入文件"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_action_import" />

                    <ImageView
                        android:id="@+id/btn_good_clear"
                        android:contentDescription="清除已选输入"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_action_stop"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/good_caps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- #204（2026-10-03 用户反馈 #5）：「抓包权限」原先是页中独立小节，与页底的
                 「抓包采集（测试）」隔着一整屏 ⇒ 已挪到它下面做成展开项（见 capture_perm_row）。 -->

            <!-- #105 角色昵称：旅行者/流浪者/奇偶的显示名由玩家自定义，而词典以**官方中文名**为键
                 ⇒ 结构性不可能命中。内置猜测表的方向和 GT 对不上，已删（见 NameOverrides 的 KDoc），
                 改成让用户填。行由代码按 NameOverrides.FIELDS 生成，与抓包权限小节同一套做法。 -->
            <LinearLayout
                android:id="@+id/name_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="角色昵称"
                    android:textColor="@color/pocket_text"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/name_override_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/name_override_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/swipe_row"
                android:contentDescription="展开或收起滑动测试"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滑动测试"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/swipe_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/swipe_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/swipe_method_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/swipe_method_three"
                        android:contentDescription="三段式滑动"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="三段式"
                        android:textColor="@color/pocket_text"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/swipe_method_chain"
                        android:contentDescription="路标链滑动"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="路标链"
                        android:textColor="@color/pocket_text"
                        android:textSize="13sp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/swipe_start_y"
                        android:contentDescription="滑动起点 Y"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="起点Y"
                        android:inputType="number"
                        android:textColor="@color/pocket_text"
                        android:textColorHint="@color/pocket_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/swipe_dist"
                        android:contentDescription="滑动距离"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="距离"
                        android:inputType="number"
                        android:textColor="@color/pocket_text"
                        android:textColorHint="@color/pocket_text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_swipe_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="测试" />
                </LinearLayout>
            </LinearLayout>

            <!-- 抓包采集（2026-10-03 由悬浮窗迁入，与滑动测试同属**测试功能**）：
                 一行的开关 = 一次会话，不持久化（会话自己会结束：四段数据齐 → 入库 → 收隧道）。
                 状态直接读主进程的 CaptureSession.ui —— 管理器与它同进程，不需要过桥。 -->
            <LinearLayout
                android:id="@+id/capture_test_row"
                android:contentDescription="开始或停止抓包采集"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="抓包采集（测试）"
                        android:textColor="@color/pocket_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/capture_test_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="登录经过隧道时解出库存"
                        android:textColor="@color/pocket_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/capture_test_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />
            </LinearLayout>

            <!-- #204：抓包权限 = 抓包采集的展开项（点行开合，与 swipe_row / calibrate_row 同一套做法）。
                 行内容由代码按库的 PermissionSnapshot 生成——哪些项该出现、每项跳哪个系统页，
                 都由库判（含 ROM 差异），界面不写死。 -->
            <LinearLayout
                android:id="@+id/capture_perm_row"
                android:contentDescription="展开或收起抓包权限"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="抓包权限"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/capture_perm_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/capture_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/capture_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/capture_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/scripts_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="长按某行可恢复内置；开关控制是否出现在悬浮窗。"
                android:textColor="@color/pocket_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/notice_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_back_overlay"
        android:contentDescription="回到悬浮窗"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="44dp"
        android:text="回到悬浮窗"
        android:textColor="@color/pocket_text_muted"
        android:textSize="14sp" />
</LinearLayout>
