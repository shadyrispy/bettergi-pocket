<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本管理器（P3，2026-09-18）：本地导入 JSON + 启用开关。
  入口：首次启动 app 自动出现；之后由悬浮窗「设置」长按进入（P4）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/scripts_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="脚本管理"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scripts_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="导入本地 JSON 脚本（写入应用私有目录，不联网）；开关控制是否在悬浮窗显示。长按某行可恢复内置。" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/scripts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_import"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导入 JSON" />

        <Button
            android:id="@+id/btn_back_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="返回悬浮窗" />
    </LinearLayout>
</LinearLayout>
