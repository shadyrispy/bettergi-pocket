<?xml version="1.0" encoding="utf-8"?>
<!--
  首次启动引导（2026-09-18）。
  只在「无障碍未开」或「从未走完引导」时出现 —— 这一步修掉的是"打开 App 一闪就没了"：
  悬浮窗现在只活在无障碍服务里，无障碍没开时点开本 App 什么也看不到，且原先没有任何指引。
  ⚠️ 本页**不做横屏变体**：走到这里说明还没启动原神，设备是竖持的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="更好的原神"
        android:textColor="@color/pocket_text"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/onboarding_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="开两个开关就能用了"
        android:textColor="@color/pocket_text_muted"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ★ #311 运行模式（第 0 步）：决定后续引导走哪条链——
                 前台 = 无障碍+投影+悬浮窗；后台 = 无障碍+Shizuku，无悬浮窗。
                 两模式共用脚本管理页，模式可在管理页顶部随时切换。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pocket_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step0_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="@color/pocket_ok"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="运行模式"
                        android:textColor="@color/pocket_text"
                        android:textSize="17sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/onboard_runmode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/onboard_mode_foreground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="前台（悬浮窗）"
                        android:textColor="@color/pocket_text"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/onboard_mode_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="后台（虚拟屏）"
                        android:textColor="@color/pocket_text"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/onboard_mode_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="前台：游戏在前台跑，悬浮窗操作，需要屏幕共享授权。\n后台：游戏跑在虚拟屏上，本页操作，需要 Shizuku（下方引导），不开悬浮窗。"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ① 无障碍 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pocket_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step1_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/pocket_text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="开启无障碍"
                        android:textColor="@color/pocket_text"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/step1_action"
                        android:contentDescription="去系统设置开启无障碍"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="去开启"
                        android:textColor="@color/pocket_accent"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="它让助手能替你点按钮：自动跳过对话、扫描自动翻页，都靠它。"
                    android:textColor="@color/pocket_text"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/pocket_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="· 只在原神里生效：只有原神在前台时才动作，切到别的 App 一律停手\n· 只能看到游戏画面和上面的按钮，读不到你的输入、聊天、密码\n· 本应用没有联网权限，画面和数据不会被上传"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ② 屏幕共享（前台模式）/ Shizuku（后台模式）—— 标题与说明由 renderOnboarding 按 runMode 切 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step2_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/pocket_text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/step2_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="屏幕共享"
                        android:textColor="@color/pocket_text"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/step2_action"
                        android:contentDescription="我知道了"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="知道了"
                        android:textColor="@color/pocket_accent"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/step2_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="第一次开始扫描时，系统会问「要开始录制或投放内容吗」→ 点「立即开始」。\n它只用来**看游戏画面**做识别：画面不会保存、不会外传，随时能在悬浮窗里关掉。"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ③ 回到管理页（前台=悬浮窗；后台=球在但不操作，从通知/图标进） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pocket_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step3_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/pocket_text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/step3_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="怎么回到这里改脚本"
                        android:textColor="@color/pocket_text"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/step3_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="悬浮窗是游戏边上的小圆球。\n以后想改脚本、开关流程，**长按那个圆球面板里的「日志」按钮**就能回到本页。\n（单击那个按钮是开合识别日志。）"
                    android:textColor="@color/pocket_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/onboarding_next"
        android:contentDescription="完成引导"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_overlay_launch_selectable"
        android:gravity="center"
        android:minHeight="52dp"
        android:text="完成，去悬浮窗"
        android:textColor="@color/pocket_accent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/onboarding_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/pocket_text_muted"
        android:textSize="12sp" />
</LinearLayout>
