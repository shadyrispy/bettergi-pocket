<?xml version="1.0" encoding="utf-8"?><!--
   ★ A30：自动备份规则（Android 11 及以下走 android:fullBackupContent，12+ 走 data_extraction_rules）。
   取舍依据：allowBackup="false" 已在应用层整体关闭备份 —— 本 app 零自建联网，GOOD 导出/脚本库
   /设置若进云备份或设备迁移，等于把用户数据送到用户无法审计的存储面，与隐私口径矛盾；
   且 MediaProjection 授权本就无法跨进程重启存活（readFromPrefs 强制 screenShare=false），
   备份还原后这些状态只会造成误导。规则文件仍按"全排除"写全（双保险：
   即使 allowBackup 被误改回 true，以下 exclude 也保证 filesDir/database/sharedprefs/外置
   目录一个都不进备份）。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
