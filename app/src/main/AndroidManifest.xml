<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 本 app 自身不联网（脚本订阅功能已移除），但抓包数据源是另一回事：
         :capture 的隧道要把截到的游戏流量**转发出去**（zdtun 开出站 socket +
         CaptureService.protect()），剥掉 INTERNET 不是"降级抓包"，是游戏掉线。
         ACCESS_NETWORK_STATE 只影响抓包能否读到本机真 DNS（拿不到就退化成公共
         解析器），一并恢复。隧道按 addAllowedApplication 只吸原神包，
         本 app 自己依旧零自建联网行为。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.miHoYo.Yuanshen" />
        <package android:name="com.miHoYo.ys.bilibili" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.miHoYo.cloudgames.ys" />
        <package android:name="com.miHoYo.cloudgames.GenshinImpact" />
        <package android:name="com.miHoYo.ys.mi" />
        <!-- ★ #310/M0 后台模式：Shizuku 授权四态机要判「已装未运行」，需要看到
             Shizuku 应用本体（targetSdk 30+ 包可见性过滤，不声明则 getPackageInfo
             恒 NameNotFoundException，状态机会永远卡在 NOT_INSTALLED）。 -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.bilibili.app.in" />
        <package android:name="tv.danmaku.bilibilihd" />
        <package android:name="com.bilibili.app.blue" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili" />
        </intent>
    </queries>

    <!-- ★ A30：allowBackup=false + 两份规则 XML 全排除 —— 备份/迁移整体关闭（依据见各 XML 注释）。 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".PocketApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterGIPocket">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BetterGIPocket.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="bettergi"
                    android:host="p"
                    android:path="/launch" />
            </intent-filter>
        </activity>

        <!-- 投影授权页不导出：仅应用内部拉起（服务 settingsListener 触发 requestCapturePermission，
             或 MainActivity 持 EXTRA_AUTO_REQUEST_CAPTURE 前台内发起）。adb 调试统一走服务广播
             DEBUG_SET_SCREEN_SHARE 触发内部链路，不直启本页。 -->
        <activity
            android:name=".capture.CapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterGIPocket.Transparent" />

        <!-- 抓包 VPN 授权中转（透明无内容，拿完结果即 finish）：系统 VPN 弹窗必须由前台
             Activity 发起，从服务 startActivity 在 Android 10+ 会被静默吞掉。 -->
        <activity
            android:name=".pcdata.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterGIPocket.Transparent" />

        <!-- 「导入 JSON」透明中转页（#205）：SAF 选择器必须由前台 Activity 发起，但不必
             把用户顶到管理器页。由 :a11y 进程直接拉起，选完自己 finish。
             ⚠️ 别照着上面两页补 noHistory —— 真机 A/B 量过，证据逐行在
             dsl/verify/runlogs/20261004_205_nohistory_ab_evidence.log：带 noHistory 时
             DocumentsUI 起来后 0.368s 就 removeAppToken 把本页销毁 ⇒ 选完文件既没有 picked
             回执也不落盘（表现＝"点了导入没反应"）；去掉后选中/取消两臂都验过。
             投影/VPN 两页保留 noHistory 成立，是因为授权框盖在同一任务上、不把发起页整页顶掉
             （同机 51 次 request→result 配对里最长 8.74s 仍收到回调）。 -->
        <activity
            android:name=".ui.GoodImportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BetterGIPocket.Transparent" />

        <service
            android:name=".service.TriggerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

        <service
            android:name=".input.InputAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":a11y"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 主进程 → 无障碍进程：下发点击 / 滑动 / 悬浮窗指令 -->
        <provider
            android:name=".input.AccessibilityBridgeProvider"
            android:authorities="${applicationId}.a11y"
            android:exported="false"
            android:process=":a11y" />

        <!-- 无障碍进程 → 主进程：读/写设置、请求导出与退出、拉识别日志镜像 -->
        <provider
            android:name=".bridge.SettingsBridgeProvider"
            android:authorities="${applicationId}.settings"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ★ #310/M0 后台模式：Shizuku binder 接收器（官方模板，dev.rikka.shizuku:provider）。
             authority 固定为 ${applicationId}.shizuku；multiprocess=false 全局单实例；
             exported=true + INTERACT_ACROSS_USERS_FULL 是 Shizuku 服务端回连的门槛
             （该权限仅系统/Shell 持有，第三方 app 无法伪造请求）。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name=".debug.BalProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />
    </application>

</manifest>
