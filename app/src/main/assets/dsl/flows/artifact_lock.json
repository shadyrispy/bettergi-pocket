{
  "flow": "artifact_lock",
  "version": "1.0.0",
  "profile": "android_3200x1440",
  "description": "流程四：按外部规则批量加解锁。输入 = lock/unlock 的 GoodArtifact 列表（决策在执行器外）",
  "vars": {
    "targets": "list<GoodArtifact>"
  },
  "ui": {
    "label": "圣遗物锁定",
    "icon": "lock",
    "order": 40
  },
  "steps": [
    {
      "do": "enterScreen",
      "target": "artifact_backpack",
      "chain": [
        "game_home→bagpack"
      ],
      "anchor": {
        "kind": "ocr",
        "rect": "$screens._common.titleBar",
        "expect": "背包",
        "retries": 3
      },
      "note_tabfix20260913": "2026-09-13：入口链拆两段 + 每段标题确认（原因同 artifact_scan：背包记住上次类别 ⇒ 直接点 artifact_tab 可能落到错误状态）。"
    },
    {
      "do": "enterScreen",
      "target": "artifact_backpack",
      "chain": [
        "artifact_tab"
      ],
      "anchor": {
        "kind": "ocr",
        "rect": "$screens._common.titleBar",
        "expect": "圣遗物",
        "retries": 3
      }
    },
    {
      "do": "setFilter",
      "entry": "BACKPACK",
      "chain": [
        "filterRoundBtn(357,1294)",
        "filterPanel.setPlus(600,340)"
      ],
      "selectByOcr": {
        "grid": "set_filter_popup",
        "dict": "mappings.artifactSets",
        "match": "exact"
      },
      "tailGuard": "确认后若 filterPanel 锚[179,50,419,104]仍在 → 点 ok[798,1307]（双层关闭，拍板成立；guard 为冗余防护）"
    },
    {
      "do": "foreach",
      "over": "$plan",
      "as": "task",
      "note": "§15 P0-3：ifMatch 以 currentTask 为闸，必须经 foreach 注入才有值",
      "steps": [
        {
          "do": "pagedGrid",
          "grid": "artifact_backpack",
          "pageSkip": {
            "expr": "pageMinLevel > max(targets.level)",
            "note": "末格 OCR 等级 → 全页跳过"
          },
          "visit": [
            {
              "do": "stopWhen",
              "mode": "duplicateStreak",
              "streak": 3,
              "dupPageConfirm": 2,
              "action": "Stop",
              "note": "阈值不再承担「回卷」判据：pagedGrid 内引擎按**该网格一页的卡片数**（cols×traverseRows）自动覆盖（见 ScanEngine.dupLimitEffective）；此处的 3 仅作 snap/rosterFind 等非翻页路径的兜底。"
            },
            {
              "do": "vote",
              "zone": "artifact.card.lockBadge",
              "passes": 3,
              "as": "gridLocked"
            },
            {
              "do": "click",
              "fast": {
                "at": "$cell.center"
              }
            },
            {
              "do": "parsePanel",
              "panel": "artifact_backpack",
              "fields": [
                "全部字段"
              ],
              "match": "hardMatch(副词条容差0.100001)"
            },
            {
              "do": "ifMatch",
              "then": [
                {
                  "do": "vote",
                  "zone": "artifact.panel.lock",
                  "as": "curLock",
                  "ambiguous": "sleep重截×2"
                },
                {
                  "do": "ifMatch",
                  "when": "curLock == false",
                  "then": [
                    {
                      "do": "click",
                      "fast": {
                        "at": "$zones.artifact.panel.lock"
                      },
                      "note": "面板 lock 钮机读：$zones.artifact.panel.lock（2560 实测 [2286,724,2332,764] center(2309,744)）；祝圣 yShift+63"
                    },
                    {
                      "do": "verify",
                      "zone": "artifact.panel.lock",
                      "expect": "true"
                    }
                  ]
                }
              ]
            }
          ],
          "stopWhenPageEnd": {
            "expr": "allMatched && stop_on_all_matched"
          }
        }
      ]
    }
  ],
  "endConditions": [
    "全部 matched + stop_on_all_matched",
    "遍历完"
  ],
  "pending": [
    "swipe settle 真机"
  ]
}