{
 "flow": "weapon_scan",
 "version": "1.0.0",
 "profile": "android_3200x1440",
 "description": "流程一：武器背包全量扫描 → GoodWeapon (GOOD v3)",
 "vars": {
  "total": "int",
  "seen": "set<fingerprint>",
  "results": "list<GoodWeapon>"
 },
 "steps": [
  {
   "do": "enterScreen",
   "target": "weapon_backpack",
   "chain": [
    "game_home→bagpack(2786,36)",
    "weapon_tab(210,196,290,321)"
   ],
   "anchor": {
    "kind": "ocr",
    "rect": "$screens.weapon_backpack.count",
    "expect": "武器 \\d+/\\d+",
    "prefixStrict": true
   }
  },
  {
   "do": "readCount",
   "rect": "$screens.weapon_backpack.count",
   "as": "total",
   "onZero": "reopenAndRetry"
  },
  {
   "do": "pagedGrid",
   "grid": "weapon_backpack",
   "fingerprintSkip": true,
   "visit": [
    {
     "do": "vote",
     "zone": "weapon.card.starStrip",
     "passes": 3,
     "as": "rarity"
    },
    {
     "do": "stopWhen",
     "expr": "rarity <= 2",
     "action": "Stop+flush",
     "note": "拍板定稿：检测到 1★灰/2★绿即止扫，不再用武器名名单"
    },
    {
     "do": "vote",
     "zone": "weapon.card.lockBadge",
     "passes": 3,
     "as": "locked"
    },
    {
     "do": "click",
     "fast": {
      "at": "$cell.center"
     },
     "fallback": [
      {
       "kind": "ocrAnchor",
       "region": "$panel.weapon_backpack.name"
      }
     ]
    },
    {
     "do": "parsePanel",
     "panel": "weapon_backpack",
     "fields": [
      "name",
      "slot",
      "mainLabel",
      "mainValue",
      "baseLabel",
      "baseValue",
      "level",
      "refine",
      "equipped"
     ],
     "dict": {
      "name": "mappings.weapons",
      "fuzzy": 1
     }
    },
    {
     "do": "emit",
     "as": "GoodWeapon",
     "compose": {
      "rarity": "$rarity",
      "locked": "$locked"
     }
    }
   ]
  }
 ],
 "endConditions": [
  "stopWhen 触发",
  "pagedGrid 自然遍历完（总数核对 total==len(results)）"
 ],
 "pending": [
  "swipe settle 真机",
  "2★ 绿色底色旁证补采样（非阻断）"
 ]
}